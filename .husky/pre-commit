#!/bin/sh
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR | grep '^frontend/.*\(\.ts\|\.tsx\|\.js\|\.jsx\|\.json\|\.css\)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

cd frontend
relative_files=$(printf '%s\n' "$files" | sed 's#^frontend/##')

printf '%s\n' "$relative_files" | xargs yarn prettier --write
printf '%s\n' "$files" | xargs git -C .. add --
